<?xml version="1.0" encoding="utf-8"?>
<!--
  CineIsle GSY 播放器控件。

  排布与 mpv 播放页保持同一套层级：
  · 顶栏：返回 / 网络速度 / 竖屏快捷键（字幕、音轨、收藏、切换内核）；
    横屏时标题搬到返回键右侧，快捷键仍靠右。
  · 正中：后退 10 秒 / 上一集 / 播放暂停 / 下一集 / 前进 10 秒。
  · 底栏：单行可横向滚动的扩展控制 → 标题（仅竖屏）→ 时间与进度条。
  · 控件隐藏时仅保留底部 2dp 进度线。

  GSYVideoControlView.init() 依赖的 id 与类型必须保留：
  surface_container(ViewGroup)、thumb(RelativeLayout)、layout_top/layout_bottom(ViewGroup)、
  progress(SeekBar)、current/total/title(TextView)、back/fullscreen/lock_screen(ImageView)、
  start(View)、loading(View)、bottom_progressbar(ProgressBar)。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/surface_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 空透明封面层：保留 GSY 状态机所需 id，但不遮挡画面。 -->
    <RelativeLayout
        android:id="@+id/thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <View
        android:id="@+id/gsy_scrim_top"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/gsy_scrim_top" />

    <View
        android:id="@+id/gsy_scrim_bottom"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/gsy_scrim_bottom" />

    <!-- 顶栏。安全区 paddingTop 由 GsyPlayerActivity 运行时补齐。 -->
    <LinearLayout
        android:id="@+id/layout_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/gsy_ctrl_circle"
            android:contentDescription="@string/player_control_back"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/gsy_ic_back" />

        <TextView
            android:id="@+id/gsy_net_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:drawablePadding="3dp"
            android:gravity="center_vertical"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp"
            android:typeface="monospace"
            android:visibility="gone" />

        <!-- 竖屏时把快捷键推到右侧；横屏标题进顶栏后收起。 -->
        <View
            android:id="@+id/gsy_top_spacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 与 mpv 竖屏顶栏一致：轨道类快捷入口放在右侧。 -->
        <ImageView
            android:id="@+id/gsy_btn_subtitle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/gsy_ctrl_circle"
            android:contentDescription="@string/gsy_control_subtitle"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/gsy_ic_subtitle" />

        <ImageView
            android:id="@+id/gsy_btn_audio_track"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/gsy_ctrl_circle"
            android:contentDescription="@string/gsy_control_audio_track"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/gsy_ic_audio_track" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/gsy_btn_favorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp" />

        <ImageView
            android:id="@+id/gsy_btn_engine"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/gsy_ctrl_circle"
            android:contentDescription="@string/gsy_control_switch_engine"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/gsy_ic_switch" />
    </LinearLayout>

    <!--
      底栏采用 mpv 竖屏页的顺序：按钮簇在上、标题紧贴进度条、进度条在最底。
      横屏时标题会搬到顶栏，底栏自然只剩单行按钮和进度条。
    -->
    <LinearLayout
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <!--
          所有次级功能收进一条横向滚动控制带，避免原先两排“工具箱”式堆叠。
          顺序与 mpv 页一致：播放状态类在前，内容类居中，画面类收在末尾。
        -->
        <HorizontalScrollView
            android:id="@+id/gsy_controls_scroller"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="2dp"
            android:clipToPadding="false"
            android:fadingEdge="horizontal"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/gsy_extra_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/gsy_btn_speed"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/gsy_ctrl_circle"
                    android:contentDescription="@string/gsy_control_speed"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/gsy_ic_speed" />

                <ImageView
                    android:id="@+id/gsy_btn_loop"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/gsy_ctrl_circle"
                    android:contentDescription="@string/gsy_control_loop"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/gsy_ic_loop" />

                <ImageView
                    android:id="@+id/gsy_btn_mute"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/gsy_ctrl_circle"
                    android:contentDescription="@string/gsy_control_mute"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/gsy_ic_volume_on" />

                <ImageView
                    android:id="@+id/gsy_btn_screenshot"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/gsy_ctrl_circle"
                    android:contentDescription="@string/gsy_control_screenshot"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/gsy_ic_screenshot" />

                <ImageView
                    android:id="@+id/gsy_btn_chapters"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/gsy_ctrl_circle"
                    android:contentDescription="@string/gsy_control_chapters"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/gsy_ic_chapters" />

                <ImageView
                    android:id="@+id/gsy_btn_pip"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/gsy_ctrl_circle"
                    android:contentDescription="@string/gsy_control_pip"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/gsy_ic_pip" />

                <ImageView
                    android:id="@+id/gsy_btn_cast"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/gsy_ctrl_circle"
                    android:contentDescription="@string/gsy_control_cast"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/gsy_ic_cast" />

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/gsy_btn_dislike"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/gsy_ctrl_circle" />

                <ImageView
                    android:id="@+id/gsy_btn_aspect"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/gsy_ctrl_circle"
                    android:contentDescription="@string/gsy_control_aspect"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/gsy_ic_aspect" />

                <ImageView
                    android:id="@+id/gsy_btn_render"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/gsy_ctrl_circle"
                    android:contentDescription="@string/gsy_control_render"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/gsy_ic_render" />

                <ImageView
                    android:id="@+id/gsy_btn_filter"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/gsy_ctrl_circle"
                    android:contentDescription="@string/gsy_control_filter"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/gsy_ic_filter" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 竖屏紧贴进度条；横屏由 applyTitlePlacement 搬到顶栏。 -->
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:typeface="monospace" />

        <LinearLayout
            android:id="@+id/gsy_seek_row"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:text="00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:typeface="monospace" />

            <SeekBar
                android:id="@+id/progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:max="100"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:progressDrawable="@drawable/gsy_seek_progress"
                android:splitTrack="false"
                android:thumb="@drawable/gsy_seek_thumb" />

            <TextView
                android:id="@+id/total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:gravity="end"
                android:text="00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:typeface="monospace" />

            <ImageView
                android:id="@+id/fullscreen"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/gsy_ctrl_circle"
                android:contentDescription="@string/gsy_control_orientation"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/gsy_ic_rotate" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/bottom_progressbar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_alignParentBottom="true"
        android:max="100"
        android:progressDrawable="@drawable/gsy_bottom_progress" />

    <!-- 中央五键使用一个真实水平组，队列键隐藏后两侧 seek 键仍会自动收拢。 -->
    <LinearLayout
        android:id="@+id/gsy_center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/gsy_btn_rewind10"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/gsy_ctrl_circle"
            android:contentDescription="@string/player_control_rewind_10s"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/gsy_ic_replay_10"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/gsy_btn_prev"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/gsy_ctrl_circle"
            android:contentDescription="@string/gsy_control_prev"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/gsy_ic_prev"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/start"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/gsy_ctrl_circle"
            android:contentDescription="@string/player_control_play_pause"
            android:padding="18dp"
            android:scaleType="centerInside"
            android:src="@drawable/gsy_ic_play" />

        <ImageView
            android:id="@+id/gsy_btn_next"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/gsy_ctrl_circle"
            android:contentDescription="@string/gsy_control_next"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/gsy_ic_next"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/gsy_btn_forward10"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/gsy_ctrl_circle"
            android:contentDescription="@string/player_control_forward_10s"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/gsy_ic_forward_10"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:indeterminateTint="#FFFFFFFF"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/lock_screen"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="14dp"
        android:background="@drawable/gsy_ctrl_circle"
        android:contentDescription="@string/player_control_lock_controls"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/gsy_ic_lock"
        android:visibility="gone" />

</RelativeLayout>
