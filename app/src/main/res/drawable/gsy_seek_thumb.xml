<?xml version="1.0" encoding="utf-8"?>
<!-- 进度条把手：白色小圆点（12dp），拖动时略微放大由 GSY 自身不处理，保持极简 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:width="12dp"
                android:height="12dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
