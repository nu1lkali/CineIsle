<?xml version="1.0" encoding="utf-8"?>
<!--
  播放器控件「玻璃底」圆形：与 mpv 页面同一套设计令牌
  - 填充：黑 32%（视频画面能透出来）
  - 描边：白 14%（明暗画面下圆边都看得清）
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#52000000" />
    <stroke
        android:width="1dp"
        android:color="#24FFFFFF" />
</shape>
